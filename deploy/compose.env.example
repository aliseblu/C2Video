# Copy to deploy/compose.env and chmod 600. Never commit the filled file.
# Use docker compose --env-file deploy/compose.env ... (not plain compose).
C2VIDEO_ENV_FILE=deploy/compose.env
C2VIDEO_ENV=production
C2VIDEO_STUDIO_TOKEN=
C2VIDEO_VIEWER_TOKEN=
C2VIDEO_PORT=8765
C2VIDEO_ALLOWED_HOSTS=localhost,127.0.0.1,studio.example.com
C2VIDEO_ALLOWED_ORIGINS=https://studio.example.com
C2VIDEO_WORKER_CONCURRENCY=1
C2VIDEO_WORKER_CPUS=2.0
C2VIDEO_WORKER_MEMORY=4g
C2VIDEO_MAX_QUEUED_RUNS=100
C2VIDEO_MIN_FREE_DISK_MB=1024
# Only trust a loopback reverse proxy by default; do not use * on exposed networks.
C2VIDEO_FORWARDED_ALLOW_IPS=127.0.0.1
C2VIDEO_LLM_PROVIDER=local
C2VIDEO_LLM_API_BASE_URL=
C2VIDEO_LLM_MODEL=
C2VIDEO_LLM_API_KEY=
C2VIDEO_SOURCE_ZHIHU_ACCESS_SECRET=
TTS_PROVIDER=edge
# Local rehearsal only: set C2VIDEO_ENV=development to use HTTP cookies.
# Production needs HTTPS from a reverse proxy; the API port stays loopback-only.

