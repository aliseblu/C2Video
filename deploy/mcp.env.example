# Copy to a private .env.mcp and use --env-file /absolute/path/.env.mcp.
# Do not put model or Zhihu credentials here. The gateway does not need them.
C2VIDEO_MCP_API_URL=http://127.0.0.1:8765
# Only required if Studio access protection is enabled. Use its operator/viewer key.
C2VIDEO_MCP_API_TOKEN=
C2VIDEO_MCP_READ_ONLY=false
C2VIDEO_MCP_TIMEOUT_SECONDS=90

# Optional browser-facing Studio origin for returned links.
# C2VIDEO_MCP_PUBLIC_URL=https://studio.example.com

# HTTP transport only: an independent random key with at least 32 ASCII characters.
# C2VIDEO_MCP_TOKEN=
C2VIDEO_MCP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Requests from browser Origins are denied unless explicitly allowlisted.
# C2VIDEO_MCP_ALLOWED_ORIGINS=https://trusted.example.com
