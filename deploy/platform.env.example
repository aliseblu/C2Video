# Copy to a private environment file readable only by the service user.
# Empty operator token intentionally prevents production startup.
C2VIDEO_ENV=production
C2VIDEO_STUDIO_TOKEN=
C2VIDEO_VIEWER_TOKEN=
C2VIDEO_ALLOWED_HOSTS=studio.example.com,127.0.0.1,localhost
C2VIDEO_ALLOWED_ORIGINS=https://studio.example.com
C2VIDEO_WORKER_MODE=external
C2VIDEO_WORKER_CONCURRENCY=1
C2VIDEO_WORK_DIR=/var/lib/c2video/work
C2VIDEO_FINAL_DIR=/var/lib/c2video/final
C2VIDEO_CONFIG=/etc/c2video/c2video.toml
PYTHON_DOTENV_DISABLED=1
PYTHONUNBUFFERED=1
# Rules + free Edge TTS by default. Enable API models only after configuring billing limits.
C2VIDEO_LLM_PROVIDER=local
TTS_PROVIDER=edge
# C2VIDEO_LLM_API_BASE_URL=
# C2VIDEO_LLM_MODEL=
# C2VIDEO_LLM_API_KEY=
# C2VIDEO_SOURCE_ZHIHU_ACCESS_SECRET=
