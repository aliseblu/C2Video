# 本机密钥配置，不要提交 .env 或把密钥放到素材文件中。
# 知乎官方接口可选；本地素材导入不需要密钥。
# C2VIDEO_SOURCE_ZHIHU_ACCESS_SECRET=
# 独立的通用模型接口；知乎密钥不能当作模型密钥。
# 以下四项需一起填写；用于选材和概括改写，可能产生模型调用费用。
# 配置步骤见 docs/narration-model.md。只填密钥不切换 provider 不会启用模型。
# C2VIDEO_LLM_PROVIDER=api
# C2VIDEO_LLM_API_BASE_URL=
# C2VIDEO_LLM_MODEL=
# C2VIDEO_LLM_API_KEY=
# 自动记忆复用上述模型配置；关闭时仍可保存普通反馈。
# C2VIDEO_MEMORY_ENABLED=true
# C2VIDEO_MEMORY_MIN_CONFIDENCE=0.8
# C2VIDEO_MEMORY_TIMEOUT_SECONDS=30
# 可选：填写真实的每百万 Token 美元单价以启用费用估算；默认保持未知。
# C2VIDEO_LLM_INPUT_USD_PER_MILLION=
# C2VIDEO_LLM_OUTPUT_USD_PER_MILLION=
TTS_PROVIDER=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+12%


# 可选：固定媒体工具绝对路径；通常不用填写，已安装的 ffmpeg-full 会自动识别。
# C2VIDEO_FFMPEG=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# C2VIDEO_FFPROBE=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe



